# Copy to .env.local for development. NEVER commit real values; .env.local is git-ignored.
# Validated by src/env.ts — an invalid production environment fails the build.

# --- Required in production -------------------------------------------------------------
# Canonical public origin (https, no trailing slash). Drives canonical URLs, sitemap, Open Graph and JSON-LD.
# Development falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form delivery (optional: without these, submissions are accepted but not delivered) -------
# Where messages are sent. Defaults to the primary email in src/config/contact.config.ts.
CONTACT_TO_EMAIL=
# "Display Name <address@your-verified-domain>" — required when RESEND_API_KEY is set.
CONTACT_FROM_EMAIL=
# Server-side secret. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# --- Rate limiting behind a reverse proxy (recommended in production) --------------------
# Header your proxy sets with the real client IP: x-forwarded-for | x-real-ip | cf-connecting-ip | x-vercel-forwarded-for
# Leave empty if you are not behind a proxy you control — per-IP limiting is then skipped rather than trusting a forgeable header.
TRUSTED_PROXY_HEADER=
# Number of trusted proxies appended to x-forwarded-for (the client IP is the Nth entry from the right). Default 1.
TRUSTED_PROXY_HOPS=1

# --- Internal tooling ---------------------------------------------------------------
# Expose /render/* (only needed to run `node scripts/render-stills.mjs` against a production build). Default false.
ENABLE_RENDER_ROUTES=false
